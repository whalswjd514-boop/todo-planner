# MongoDB connection string (Atlas or local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/todo-planner

# Auth.js — generate AUTH_SECRET with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Fixes the OAuth redirect_uri; must be the origin of the GitHub OAuth App callback URL
AUTH_URL=http://localhost:3000

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
